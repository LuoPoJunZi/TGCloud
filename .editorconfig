root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,sh}]
indent_size = 2

[*.ps1]
end_of_line = crlf

[*.md]
# Markdown may intentionally use two trailing spaces for a hard line break.
trim_trailing_whitespace = false
max_line_length = off
